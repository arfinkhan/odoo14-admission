<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_application_steps" model="ir.sequence">
        <field name="name">Application Main Steps</field>
        <field name="code">application.main.steps</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
    </record>

    <!-- Auto-generated candidate login number, assigned once at signup
         and reused for every application that candidate makes. -->
    <record id="seq_admission_candidate_login" model="ir.sequence">
        <field name="name">Admission Candidate Login No</field>
        <field name="code">admission.candidate.login</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="number_next">10001</field>
    </record>
</odoo>
