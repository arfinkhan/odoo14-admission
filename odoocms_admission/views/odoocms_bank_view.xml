<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoocms_bank_tree" model="ir.ui.view">
        <field name="name">odoocms.bank.tree</field>
        <field name="model">odoocms.bank</field>
        <field name="arch" type="xml">
            <tree string="Banks">
                <field name="name"/>
                <field name="account_title"/>
                <field name="account_no"/>
                <field name="iban_no"/>
                <field name="branch"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_odoocms_bank_form" model="ir.ui.view">
        <field name="name">odoocms.bank.form</field>
        <field name="model">odoocms.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. HBL, MCB, Meezan Bank"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_title"/>
                            <field name="account_no"/>
                        </group>
                        <group>
                            <field name="iban_no"/>
                            <field name="branch"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoocms_bank" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">odoocms.bank</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a bank account here, then select it from any Admission Register -
                account title, account number, and IBAN will fill in automatically.
            </p>
        </field>
    </record>

    <menuitem
            id="menu_odoocms_bank"
            name="Banks"
            parent="menu_admission_configuration"
            action="action_odoocms_bank"
            groups="odoocms_admission.group_admission_manager"
            sequence="15"/>
</odoo>
