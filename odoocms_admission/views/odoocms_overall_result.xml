<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_odoocms_overall_result_tree" model="ir.ui.view">
            <field name="name">odoocms.overall.result.tree</field>
            <field name="model">odoocms.overall.result</field>
            <!--<field name="priority" eval="8" />-->
            <field name="arch" type="xml">
                <tree string="Subject Wise Result">
                    <field name="cnic"/>
                    <field name="name"/>
                    <field name="session" />
                    <field name="total_score" />
                </tree>
            </field>
        </record>
        <record id="view_odoocms_overall_result_form" model="ir.ui.view">
            <field name="name">odoocms.subject.overall.form</field>
            <field name="model">odoocms.overall.result</field>
            <field name="arch" type="xml">
                <form string="Overall Result">
                    <sheet>
                        <group>
                            <group>
                                <field name="cnic" />
                                <field name="name" />
                            </group>
                            <group>
                                <field name="test_series" />
                                <field name="session" />
                                <field name="discipline" />
                                <field name="total_score" />
                            </group>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>
         <record id="action_odoocms_overall_score" model="ir.actions.act_window">
        <field name="name">Test Score</field>
        <field name="res_model">odoocms.overall.result</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create Your Score here.
            </p>
        </field>
    </record>
        <menuitem
            id="menu_odoocms_over_test_score"
            name="Test Score"
            parent="menu_admission_configuration"
            action="action_odoocms_overall_score"
            sequence="141"/>
       <!--groups="odoocms.group_cms_manager,odoocms_admission.group_admission_manager"-->
    </data>
</odoo>